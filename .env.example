# ── Assistant IA ───────────────────────────────────────────────
# Option 1 (gratuite) : clé Gemini de Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modèle Gemini (facultatif) ; par défaut « gemini-flash-latest », toujours le plus récent.
# GEMINI_MODEL=gemini-flash-latest

# Option 2 : clé Claude (Anthropic) — https://platform.claude.com
# ANTHROPIC_API_KEY=

# Si les deux clés sont définies, Gemini est utilisé ; pour forcer : AI_PROVIDER=gemini ou anthropic
# AI_PROVIDER=

# Sans aucune clé côté serveur, chaque utilisateur peut quand même activer l'IA avec sa propre
# clé Gemini gratuite, dans « Assistant IA → Réglages de l'IA » (fonctionne aussi sur GitHub Pages).

# Optionnel : nombre maximal de requêtes IA par adresse IP et par heure.
AI_RATE_LIMIT_PER_HOUR=60

# Optionnel : sites autorisés à appeler cette API depuis le navigateur
# (si l'application est publiée sur GitHub Pages et l'API ailleurs).
# AI_ALLOWED_ORIGINS=https://souleymane2022.github.io
