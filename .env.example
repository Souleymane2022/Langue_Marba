# Clé API Anthropic (https://platform.claude.com) — nécessaire pour l'assistant IA.
# Sans clé, le dictionnaire, les leçons, les quiz et la traduction mot à mot
# fonctionnent quand même (hors-ligne).
ANTHROPIC_API_KEY=

# Optionnel : nombre maximal de requêtes IA par adresse IP et par heure.
AI_RATE_LIMIT_PER_HOUR=60
